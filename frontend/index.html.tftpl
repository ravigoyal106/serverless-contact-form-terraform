<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Serverless Contact Form on AWS</title>
<style>
  * { box-sizing: border-box; margin: 0; padding: 0; }
  body { font-family: -apple-system, sans-serif; min-height: 100vh; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 40px 20px; background: radial-gradient(circle at 20% 20%, #1b2540 0%, #0a0e1a 55%, #05070d 100%); color: #e8ebf5; }
  h1 { font-size: 32px; margin-bottom: 24px; text-align: center; }
  .card { width: 100%; max-width: 440px; background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.08); border-radius: 16px; padding: 32px; }
  label { display: block; font-size: 13px; margin-bottom: 6px; color: #b6bfda; }
  input, textarea { width: 100%; padding: 11px; margin-bottom: 16px; font-size: 14px; color: #e8ebf5; background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.12); border-radius: 8px; }
  textarea { min-height: 100px; }
  button { width: 100%; padding: 12px; font-size: 14px; font-weight: 600; color: #05070d; background: linear-gradient(90deg, #ff9900, #ffb84d); border: none; border-radius: 8px; cursor: pointer; }
  #status { margin-top: 14px; font-size: 13px; text-align: center; }
</style>
</head>
<body>
  <h1>Serverless Contact Form on AWS</h1>
  <div class="card">
    <form id="contactForm">
      <label for="name">Name</label>
      <input type="text" id="name" required>
      <label for="email">Email</label>
      <input type="email" id="email" required>
      <label for="message">Message</label>
      <textarea id="message" required></textarea>
      <button type="submit">Send</button>
      <p id="status"></p>
    </form>
  </div>
  <script>
    const API_URL = "${api_url}";
    document.getElementById("contactForm").addEventListener("submit", async (e) => {
      e.preventDefault();
      const statusEl = document.getElementById("status");
      statusEl.textContent = "Sending...";
      try {
        const res = await fetch(API_URL, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            name: document.getElementById("name").value,
            email: document.getElementById("email").value,
            message: document.getElementById("message").value
          })
        });
        const data = await res.json();
        statusEl.textContent = res.ok ? "Thanks - we'll be in touch!" : (data.error || "Something went wrong.");
      } catch (err) {
        statusEl.textContent = "Network error - please try again.";
      }
    });
  </script>
</body>
</html>